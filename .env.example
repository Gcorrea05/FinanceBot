
# Database
DATABASE_URL=sqlite:///data/finance.db

# Telegram
TELEGRAM_TOKEN=

# Local REST API
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Automations
AUTOMATION_POLL_INTERVAL_SECONDS=60
# Architecture hardening
TELEGRAM_TIMEOUT_SECONDS=30
TELEGRAM_ADMIN_CHAT_ID=
SQLITE_FOREIGN_KEYS=true
SQLITE_WAL_ENABLED=true
SQLITE_BUSY_TIMEOUT_MS=10000
SQLITE_WAL_AUTOCHECKPOINT=1000
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_BACKUP_ENABLED=true
SQLITE_BACKUP_DIRECTORY=backups/sqlite
AI_ENABLED=false
AI_PROVIDER=disabled
AI_MODEL=
AI_TEMPERATURE=0.2
AI_API_KEY=
SCHEDULER_TIMEZONE=America/Sao_Paulo
SCHEDULER_TICK_SECONDS=1
EVENT_POLL_INTERVAL_SECONDS=15
MONTHLY_REPORT_ENABLED=true
MONTHLY_REPORT_HOUR=7
REPORT_DIRECTORY=data/reports
LOG_CLEANUP_DAYS=30
SQLITE_BACKUP_HOUR=3
LOG_DIRECTORY=logs
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
EXPOSE_API_DOCS=true
TRUSTED_HOSTS=localhost,127.0.0.1

# Local Docker production
PRODUCTION_DATABASE_URL=sqlite:////app/data/finance.db
PRODUCTION_API_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
PRODUCTION_LOG_DIRECTORY=/app/logs
PRODUCTION_REPORT_DIRECTORY=/app/data/reports
PRODUCTION_SQLITE_BACKUP_DIRECTORY=/app/backups/sqlite
PRODUCTION_SQLITE_BACKUP_ENABLED=true
PRODUCTION_SQLITE_BUSY_TIMEOUT_MS=10000
PRODUCTION_SQLITE_WAL_AUTOCHECKPOINT=1000
PRODUCTION_SQLITE_SYNCHRONOUS=NORMAL
PRODUCTION_EXPOSE_API_DOCS=false
PRODUCTION_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
PRODUCTION_WEB_BIND_ADDRESS=127.0.0.1
PRODUCTION_WEB_PORT=8080
